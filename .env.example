# Copy to .env (gitignored) and fill in. Everything the service reads is here.

# --- Teradata ---
TD_HOST=your-environment.env.trial.teradata.com
TD_USER=demo_user
TD_PASSWORD=change-me

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# ONE model for every LLM call: chat answers, the alert brief, the relevance check on brief answers, and the on-topic gate.
# Any chat model your key can use, e.g. gpt-5-mini, gpt-5, gpt-5.4, gpt-4.1, gpt-4o-mini.
LLM_MODEL=gpt-5-mini
# gpt-5 models only (ignored by older ones): minimal | low | medium | high. Higher = slower and more careful.
REASONING_EFFORT=low

# Embedding model for the documents and for questions. If you change it, re-embed the documents:
#   python scripts/ingest_policies.py
EMBED_MODEL=text-embedding-3-small

# Optional. Leave blank to use LLM_MODEL everywhere (recommended).
VERIFY_MODEL=
GATE_MODEL=
